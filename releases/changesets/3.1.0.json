  "changes": [
    {
      "id": "lower-and-project-host-plugins",
      "title": "Lower and project host plugins",
      "summary": "The `@capability` and `@agent-profile` words gain an invocation section and `@distribution` a product section; ia init --from lowers a Claude, Codex or Grok plugin into a kit workspace; ia project --product plugin renders it back and --check proves the round trip.",
      "packages": [
        "@inventarch/agent-composition-system",
        "@inventarch/authoring-system",
        "@inventarch/cli",
        "@inventarch/compliance",
        "@inventarch/mcp-door",
